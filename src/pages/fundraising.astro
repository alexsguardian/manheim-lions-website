---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Heading, Link } from 'accessible-astro-components'
import PageHeader from '@components/PageHeader.astro'
import ContentMedia from '@components/ContentMedia.astro'
import { Icon } from 'astro-icon/components'

import broomImage from '@assets/img/fundraisers/fund-brooms.webp'
import sandwichImage from '@assets/img/fundraisers/fund-halfHC.webp'
import makerMarket from '@assets/img/fundraisers/fund-makers-market.webp'
import santaRunPoster from '@assets/img/santa-run/santa-5k-raceStart.webp'
import farmshowPoster from '@assets/img/fundraisers/fund-farm-show-stand.webp'
---

<DefaultLayout
  title="Fundraisers"
  description="Support the Manheim Lions Club through our fundraisers: broom sales, the Santa 5K Run & Walk, our Pennsylvania Farm Show food stand, and more. All proceeds support projects in Manheim, PA."
>
  <PageHeader
    title="Fundraising"
    subtitle="Details about specific fundraisers and initiatives that help us make a difference."
    bgType="gradient"
    showBreadcrumbs={false}
  />
  <section class="space-content container my-16">
    <ContentMedia imgSrc={broomImage} reverseImg={true} alt="Image of Brooms" allowEnlarge={false}>
      <Heading level="h2">Brooms!</Heading>
      <p class="text-lg">
        Need a new broom? Support our fundraising efforts by purchasing brooms from the Manheim Lions Club! Our brooms
        are perfect for keeping your home clean while also helping us support our community initiatives.
      </p>
      <p class="text-lg">
        You can find us at most Manheim community events throughout the year or purchase them at <Link
          href="https://shaubsdrycleaning.com/"
          target="_blank">Shaub's Dry Cleaning</Link
        >.
      </p>
    </ContentMedia>
    <ContentMedia
      imgSrc={sandwichImage}
      reverseImg={false}
      alt="Ham and Cheese Sandwiches Poster"
      allowEnlarge={false}
    >
      <Heading level="h2">Sandwich Sales</Heading>
      <p class="text-lg">
        Support our fundraising efforts by purchasing delicious Ham & Cheese sandwiches from the Manheim Lions Club! Our
        sandwiches are made with 5oz of Ham and 1oz of Swiss Cheese. Great for easy lunches!
      </p>
      <p class="text-lg">
        We have two sandwich sales each year. Halfway to the Farm Show in April, and during the Manheim Farm Show in
        October. Watch our home page and calendar for upcoming dates!
      </p>
    </ContentMedia>
    <ContentMedia
      imgSrc={makerMarket}
      reverseImg={true}
      alt="Manheim Maker's Market Logo"
      allowEnlarge={false}
    >
      <Heading level="h2">Manheim Maker's Market</Heading>
      <p class="text-lg">
        Support our fundraising efforts by purchasing unique handmade items from local artisans at the Manheim Maker's
        Market! Your purchases help fund our community initiatives. In partnership with The Shank Shoppe.
      </p>
      <p class="text-lg">
        The Maker's Market takes place once a year, in August. Watch our home page and calendar for upcoming dates!
      </p>
    </ContentMedia>
  </section>
  <section class="container my-16">
    <ContentMedia
      imgSrc={santaRunPoster}
      reverseImg={false}
      alt="Santa 5K Run & Walk Poster"
      allowEnlarge={false}
    >
      <Heading level="h2">Santa 5K Run & Walk</Heading>
      <p class="text-lg">
        The Manheim Lions club hosts an annual Santa 5K Run & Walk to raise funds for various community projects and
        charitable causes. The event is open to participants of all ages and fitness levels. Runners and walkers are
        encouraged to dress in festive holiday attire to celebrate the season.
      </p>
      <Link href="/santa-5k" isButton size="md" class="mt-4" type="primary">
        Learn More
        <Icon aria-hidden="true" name="lucide:arrow-right" size={24} />
      </Link>
    </ContentMedia>
    <ContentMedia
      imgSrc={farmshowPoster}
      reverseImg={true}
      alt="Manheim Farm Show Stand Poster"
      allowEnlarge={false}
    >
      <Heading level="h2">Manheim Farm Show Stand</Heading>
      <p class="text-lg">
        Support our fundraising efforts by visiting the Manheim Lions Club stand at the Manheim Farm Show! We offer a variety
        of items for sale, including our popular Ham & Cheese sandwiches. Your purchases help fund our community initiatives.
      </p>
      <p class="text-lg">
        The Manheim Farm Show takes place annually in October (first full week). Watch our home page and <a href="/calendar">calendar</a> for upcoming dates!
      </p>
    </ContentMedia>
  </section>
  <section class="container">
    <hr class="mx-30 my-16 border-t-2 border-gray-300" aria-hidden="true" />
    <Heading level="h3">Fundraising Notice</Heading>
    <p class="text-lg">
      All fundraising activities conducted by the Manheim Lions Club are in strict compliance with Lions Clubs
      International policies and local regulations. We are committed to transparency and accountability in all our
      fundraising efforts. If you have any questions or concerns about our fundraising activities, please do not
      hesitate to contact us.
    </p>
    <br />
    <p>
      All funds raised go directly towards supporting our community service projects, including vision and hearing
      programs, youth initiatives, and disaster relief efforts. We sincerely thank you for your support and generosity,
      which enables us to continue serving our community.
    </p>
  </section>
</DefaultLayout>
