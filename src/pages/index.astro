---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import ContentMedia from '@components/ContentMedia.astro'
import ContentVideo from '@components/ContentVideo.astro'
import { Heading, Link, Notification } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

import medPic from '@assets/img/medical-equipment.webp'
import cubpack from '@assets/img/cubpack-photo.webp'
import event1 from '@assets/img/easter-hunts/egg-hunt-poster.webp'
import event2 from '@assets/img/easter-hunts/egg-hunt-poster-vp.webp'
import weserve from '@assets/img/we-serve-award-flyer.webp'
import htfs from '@assets/img/htfs-sale-poster.webp'

const packURL = import.meta.env.PUBLIC_PACK_URL
---

<DefaultLayout title="Home">
  <Hero />

  <!-- Feature Section -->
  <section class="bg-[var(--brand-secondary)] py-24">
    <ContentVideo
      videoUrl="https://youtu.be/QLwcNtbF5Xc"
      reverseVideo={true}
      aspect="16/9"
      title="Volunteering Changed My Life | Being a Lion - From YouTube"
      poster="/assets/img/no-video.jpg"
      caption="Video from Lions International on YouTube"
    >
      <Heading level="h2" class="text-white dark:text-white">What is a Lion?</Heading>
      <p class="text-lg text-white dark:text-white">
        When caring people join together, roll up their sleeves and take action to make their community better, it’s a
        beautiful thing—and an incredible feeling for everyone involved. That’s Lions. Being a Lion is about leading by
        example, building relationships and improving the world through kindness. It’s 1.4 million caring men and women
        serving together so they can make a lasting impact and change more lives.
      </p>
      <Link href="/calendar" isButton type="primary" animateOnHover animationType="boop">
        Attend a Meeting
        <Icon aria-hidden="true" name="lucide:arrow-right" size="1.5rem" />
      </Link>
    </ContentVideo>
  </section>

  <!-- Upcoming Events Section -->
  <section class="container my-24 text-center">
    <div>
      <Heading level="h2" class="text-3xl">Upcoming Events & Fundraisers</Heading>

      <p>Check below for upcoming events and fundraisers that we participate in or running!</p>

      <hr class="mx-auto mb-4 max-w-[50%] border-t-2 border-gray-300" aria-hidden="true" />

      <ContentMedia
        imgSrc={event1.src}
        reverseImg={false}
        aria-label="Easter Egg Hunt Event"
        allowEnlarge={true}
      >
        <Heading level="h3">Annual Manheim Lions Easter Egg Hunt</Heading>
        <div class="flex flex-col space-content">
          <p class="text-lg">
            Join us for our annual Easter Egg Hunt on Saturday, April 4th. Starting at 1:00 PM!
          </p>
          <Link href="/easter-egg-hunts" isButton class="mx-auto justify-center" type="primary" animateOnHover animationType="boop">
            Learn more
            <Icon aria-hidden="true" name="lucide:arrow-right" size="1.5rem" />
          </Link>
        </div>
      </ContentMedia>

      <ContentMedia
        imgSrc={event2.src}
        reverseImg={true}
        aria-label="Easter Egg Hunt for the Visually Impaired Event"
        allowEnlarge={true}
      >
        <Heading level="h3">Annual Manheim Lions Easter Egg Hunt for the Visually Impaired</Heading>
        <div class="flex flex-col space-content">
          <p class="text-lg">
            Join us for our annual Easter Egg Hunt for the visually impaired on Saturday, April 4th. Starting at 10:00 AM!
          </p>
          <Link href="/easter-egg-hunts" isButton class="mx-auto justify-center" type="primary" animateOnHover animationType="boop">
            Learn more
            <Icon aria-hidden="true" name="lucide:arrow-right" size="1.5rem" />
          </Link>
        </div>
      </ContentMedia>

      <ContentMedia
        imgSrc={weserve.src}
        reverseImg={false}
        aria-label="We Serve Award Flyer"
        allowEnlarge={true}
      >
        <Heading level="h3">We Serve Award</Heading>
        <div class="flex flex-col space-content">
          <p class="text-lg">
            The Manheim Lions club is proud to recognize students in the Manheim Central School District who have made a positive impact in their community with the We Serve Award. This award is given to students who have demonstrated outstanding service and leadership in their community, embodying the Lions' motto of "We Serve." Students, apply using the link below. Applications are due before April 3rd, 2026.
          </p>
          <Link href="/api/download-resource?resource=we-serve-award" isButton class="mx-auto justify-center" type="primary" animateOnHover animationType="boop">
            Download Application
            <Icon aria-hidden="true" name="lucide:cloud-download" size="1.5rem" />
          </Link>
        </div>
      </ContentMedia>

      <ContentMedia
        imgSrc={htfs.src}
        reverseImg={true}
        aria-label="Halfway to the Farm Show Sandwich Sale Flyer"
        allowEnlarge={true}
      >
        <Heading level="h3">Halfway to the Farm Show Sandwich Sale</Heading>
        <div class="flex flex-col space-content">
          <p class="text-lg">
            Join us for our annual Halfway to the Farm Show Sandwich Sale on Saturday, April 25th. From 11AM - 2PM (or until sold out) at Trinity EC Church! We will be selling delicious sandwiches to support our community initiatives. Don't miss out on this tasty event!
          </p>
          <Link href="https://forms.gle/y6wtzx6XRHinmsv6A" isButton class="mx-auto justify-center" target="_blank" rel="noopener" type="primary" animateOnHover animationType="boop">
            Order Form
            <Icon aria-hidden="true" name="lucide:external-link" size="1.5rem" />
          </Link>
        </div>
      </ContentMedia>
      <!-- <Notification type="info" class="mx-auto my-12 max-w-3xl justify-center">
        There are currently no upcoming events. Please check back later!
      </Notification> -->

      <hr class="mx-auto mb-4 max-w-[25%] border-t-2 border-gray-300" aria-hidden="true" />
    </div>
  </section>

  <!-- Medical Section -->
  <section class="bg-[var(--background-color)] py-24">
    <ContentMedia imgSrc={medPic.src} reverseImg={false} aria-label="Medical Equipment" allowEnlarge={false}>
      <Heading level="h2">Medical Equipment</Heading>
      <p class="text-lg">
        The Manheim Lions club operates a Medical Equipment loan program to provide temporary use of medical equipment
        to community members in need. Equipment available includes wheelchairs, travel wheelchairs, walkers, non-wheeled
        walkers, and canes. There is no charge for the use of the equipment, but donations (monetary or equipment) are
        accepted to help maintain and expand the inventory.
      </p>
      <Link href="/medical" isButton type="primary" animateOnHover animationType="boop">
        Learn more
        <Icon aria-hidden="true" name="lucide:arrow-right" size="1.5rem" />
      </Link>
    </ContentMedia>
  </section>

  <!-- Cub Scout Section -->
  <section class="container my-24">
    <ContentMedia
      imgSrc={cubpack.src}
      reverseImg={true}
      aria-label="Cub Scout Ranks (Lion, Tiger, Bobcat, Wolf, Bear, Webelos, Arrow of Light)"
      allowEnlarge={false}
    >
      <Heading level="h2">Cub Scout Pack 47</Heading>
      <p class="text-lg">
        The Manheim Lions club proudly sponsors Cub Scout Pack 47, which serves the youth of the Manheim area by
        providing a fun and educational program that promotes character development, citizenship, and personal fitness.
      </p>
      <Link href={packURL} isButton type="primary" animateOnHover animationType="boop" target="_blank" rel="noopener">
        Visit Pack 47
        <Icon aria-hidden="true" name="lucide:arrow-right" size="1.5rem" />
      </Link>
    </ContentMedia>
  </section>
</DefaultLayout>

<style>
  .avatar {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-s);
  }
</style>
