---
import CallToAction from './CallToAction.astro'
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const { showCallToAction = true } = Astro.props
const currentYear = new Date().getFullYear()
const FB_URL = import.meta.env.PUBLIC_FACEBOOK_PAGE_URL
---

<footer>
  {showCallToAction && <CallToAction />}
  <section class="py-8">
    <div class="container mb-8 grid grid-cols-1 gap-8 md:grid-cols-3">
      <div>
        <p class="font-bold">Manheim Lions Club</p>
        <p>Serving the Manheim, PA community since 1925.</p>
        <p>Manheim, PA 17545</p>
      </div>
      <div>
        <p class="font-bold">Club Meetings</p>
        <p>Usually the first Monday of the month, 7:00&ndash;8:00 PM. Meeting locations vary.</p>
        <p>
          See the <Link href="/calendar">club calendar</Link> for dates and locations. Prospective members and volunteers
          are welcome!
        </p>
      </div>
      <div>
        <p class="font-bold">Get Involved</p>
        <ul class="list-none">
          <li><Link href="/contact">Contact us</Link></li>
          <li><Link href="/medical">Borrow medical equipment</Link></li>
          <li><Link href="/eye-glasses">Donate eyeglasses</Link></li>
          {FB_URL && (
            <li>
              <Link href={FB_URL} target="_blank" rel="noopener">
                Follow us on Facebook
              </Link>
            </li>
          )}
        </ul>
      </div>
    </div>
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} - Manheim Lions Club.
      </p>
      <div class="flex flex-row gap-4">
        {FB_URL && (
          <Link href={FB_URL} target="_blank" rel="noopener" class="type-icon animate-rotate" title="Manheim Lions on Facebook">
            <Icon aria-hidden="true" name="lucide:facebook" class="text-2xl text-[var(--brand-neutral)]" />
          </Link>
        )}
        <!-- <Link href="/member-resources" class="type-icon animate-rotate" title="Member Resources">
        <Icon aria-hidden="true" name="lucide:user" class="text-black"/>
      </Link> -->
        <Link
          href="https://github.com/alexsguardian/manheim-lions-website"
          target="_blank"
          rel="noopener"
          class="type-icon animate-rotate"
          title="Website Repository"
        >
          <Icon aria-hidden="true" name="lucide:github" class="text-2xl text-[var(--brand-neutral)]" />
        </Link>
      </div>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
