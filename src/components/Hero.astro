---
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Hero Component
 *
 * @description A component that displays a hero section with a title and description
 */
---

<section class="hero my-24">
  <div class="container">
    <div class="grid grid-cols-1 items-center gap-24">
      <div class="flex flex-col items-center gap-8 md:items-start">
        <h1 class="text-center text-6xl md:text-left lg:text-8xl">
          <slot>Manheim Lions</slot>
        </h1>
        <p class="text-center text-xl md:text-left">
          Serving the Manheim, PA community since 1925.
        </p>
        <div class="flex flex-col gap-3 min-[500px]:flex-row">
          <Link href="/contact" isButton type="primary" animateOnHover animationType="boop">
            <Icon aria-hidden="true" name="lucide:send" size="1.5rem" />
            Contact Us
          </Link>
          <Link href="/medical" isButton type="default" animateOnHover animationType="boop">
            <Icon aria-hidden="true" name="lucide:heart-pulse" size="1.5rem" />
            Medical Devices
          </Link>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  h1 {
    text-wrap: unset;
  }

  .text-gradient {
    background: linear-gradient(
      315deg,
      light-dark(var(--color-primary-300), var(--color-secondary-100)) 25%,
      light-dark(var(--color-secondary-300), var(--color-primary-200))
    );
    background-clip: border-box;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
